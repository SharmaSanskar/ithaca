# Copy to .env next to docker-compose.yml. Never commit .env.

# The public hostname. Caddy gets a Let's Encrypt certificate for it on the
# first request, so ports 80 and 443 must be reachable from the internet.
#   no domain:  <server-ip-with-dashes>.sslip.io   e.g. 203-0-113-7.sslip.io
#   a domain:   ithaca.example.com (point an A record at the server first)
#   a laptop:   localhost (Caddy's local CA; your browser will warn once)
ITHACA_DOMAIN=localhost

# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Which image to run. Releases are pushed by .github/workflows/deploy.yml on
# every v* tag. For a laptop run of a local build: ITHACA_IMAGE=ithaca
# ITHACA_VERSION=dev (after `make docker`).
ITHACA_IMAGE=ghcr.io/sharmasanskar/ithaca
ITHACA_VERSION=latest

# How long the always-on demo keeps delivery history.
ITHACA_RETENTION=6h
