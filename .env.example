# Every knob Ithaca reads. Copy to .env for local overrides; the Makefile
# already exports sensible defaults matching the compose stack, so this file is
# reference documentation more than required setup.
#
# Nothing in the codebase calls os.Getenv outside internal/platform/config.

# ── core ─────────────────────────────────────────────────────────────────────
# dev | staging | prod. Controls log defaults, proxy trust and the drain delay.
ITHACA_ENV=dev

# debug | info | warn | error. Defaults to debug in dev, info elsewhere.
ITHACA_LOG_LEVEL=debug
# json | text. Defaults to text in dev, json elsewhere.
ITHACA_LOG_FORMAT=text
# Adds file:line to every record. Costs ~1µs per line.
ITHACA_LOG_SOURCE=false

# ── listeners ────────────────────────────────────────────────────────────────
# Per-service defaults, so the whole stack runs on one laptop:
#   api 8080/9080 · ingest 8081/9081 · ws 8082/9082
#   dispatcher -/9083 · worker -/9084 · receiver-sim 8090/9085
# ITHACA_HTTP_ADDR=:8080
# ITHACA_ADMIN_ADDR=:9080

ITHACA_HTTP_READ_HEADER_TIMEOUT=5s
ITHACA_HTTP_READ_TIMEOUT=30s
ITHACA_HTTP_WRITE_TIMEOUT=30s
ITHACA_HTTP_IDLE_TIMEOUT=120s

# Heap and CPU profiles on the admin port. Never routed through an Ingress.
ITHACA_PPROF=false

# ── datastores ───────────────────────────────────────────────────────────────
ITHACA_DATABASE_URL=postgres://ithaca:ithaca@localhost:5432/ithaca?sslmode=disable

# Pool size follows 2*GOMAXPROCS+8, NOT the worker-pool size — delivery workers
# hold no connection across the outbound HTTP call. Leave unset to auto-size.
# ITHACA_DB_MAX_CONNS=16
ITHACA_DB_MIN_CONNS=2
ITHACA_DB_MAX_CONN_LIFETIME=1h
ITHACA_DB_MAX_CONN_IDLE_TIME=30m
ITHACA_DB_CONNECT_TIMEOUT=10s

# Redis is off the delivery path; it only fans out live dashboard updates
# (Phase 4). Losing it costs a stale graph, never a delivery.
ITHACA_REDIS_URL=redis://localhost:6379/0

# ── telemetry ────────────────────────────────────────────────────────────────
ITHACA_OTEL_ENABLED=false
ITHACA_OTEL_ENDPOINT=localhost:4317
ITHACA_OTEL_SAMPLE_PERCENT=100

# ── dispatcher ───────────────────────────────────────────────────────────────
# Streams processed concurrently, and streams leased per dequeue round trip.
ITHACA_DISPATCH_WORKERS=64
ITHACA_DISPATCH_MAX_STREAMS_BATCH=32
# Deliveries fetched per stream per round, and rounds before a busy stream is
# released so others get a turn.
ITHACA_DISPATCH_DRAIN_BATCH=64
ITHACA_DISPATCH_MAX_DRAIN_ROUNDS=4
# Lease = max(MIN_LEASE, 2 x endpoint timeout + LEASE_PADDING). It is also the
# crash-recovery time: a dead dispatcher's streams return when leases expire.
ITHACA_DISPATCH_MIN_LEASE=30s
ITHACA_DISPATCH_LEASE_PADDING=10s
# Adaptive polling: snap to the floor when there is work, back off when idle.
ITHACA_DISPATCH_POLL_FLOOR=50ms
ITHACA_DISPATCH_POLL_CEILING=500ms
ITHACA_DISPATCH_REAP_EVERY=5s

# ── delivery ─────────────────────────────────────────────────────────────────
# Full-jitter exponential backoff. Default schedule dead-letters after ~7h.
ITHACA_RETRY_BASE=30s
ITHACA_RETRY_CAP=6h
ITHACA_RETRY_MAX_ATTEMPTS=12
# CIDRs exempt from the SSRF blocklist. Defaults to loopback in dev ONLY, so
# the local receiver-sim works. Empty (nothing exempt) everywhere else.
# ITHACA_DELIVERY_ALLOW_CIDRS=127.0.0.0/8,::1/128

# ── lifecycle ────────────────────────────────────────────────────────────────
# How long in-flight deliveries get to finish after SIGTERM.
# Kubernetes terminationGracePeriodSeconds must be larger: grace + drain + 15s.
ITHACA_SHUTDOWN_GRACE=30s

# ── AWS / LocalStack (Phase 9) ───────────────────────────────────────────────
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
